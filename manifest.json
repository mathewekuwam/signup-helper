{
  "manifest_version": 3,
  "name": "Signup Helper",
  "version": "1.3",
  "description": "Personal helper: records a manual signup flow, and replays it as an automation.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["recorder.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Signup Helper" }
}
